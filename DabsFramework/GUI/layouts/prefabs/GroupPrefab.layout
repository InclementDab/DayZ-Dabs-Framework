WrapSpacerWidgetClass EditorDialogOption {
 clipchildren 0
 inheritalpha 0
 ignorepointer 0
 color 1 1 1 1
 position 0 0
 size 1 30
 halign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 scriptclass ""
 style Empty
 Padding 3
 Margin 0
 "Size To Content H" 0
 "Size To Content V" 1
 content_halign center
 content_valign center
 {
  ButtonWidgetClass EditorDialogOptionButton {
   size 0.99 30
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   scriptclass "ViewBinding"
   style Editor
   switch toggle
   color 0.1647 0.1843 0.2157 1
   {
    FrameWidgetClass EditorDialogOptionPanel {
     clipchildren 1
     ignorepointer 1
     size 30 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     fixaspect inside
     {
      ImageWidgetClass expand_image {
       visible 1
       clipchildren 0
       inheritalpha 1
       ignorepointer 1
       color 0.3922 0.6588 0.9373 1
       size 16 16
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_collapse"
       mode blend
       "src alpha" 1
       "no wrap" 1
       stretch 1
       filter 1
      }
      ImageWidgetClass collapse_image {
       visible 0
       clipchildren 0
       inheritalpha 1
       ignorepointer 1
       color 0.3922 0.6588 0.9373 1
       size 16 16
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_expand"
       mode blend
       "src alpha" 1
       "no wrap" 1
       stretch 1
       filter 1
      }
     }
    }
    TextWidgetClass EditorDialogOptionTitle {
     clipchildren 1
     ignorepointer 1
     color 0.8667 0.8902 0.9255 1
     position 0 0
     size 0.87 30
     halign right_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     scriptclass "ViewBinding"
     text "Test Me"
     font "gui/fonts/MetronBook16"
     "size to text v" 0
     "text valign" center
     "text offset" 8 0
     {
      ScriptParamsClass {
       Binding_Name "Caption"
      }
     }
    }
    PanelWidgetClass EditorDialogOptionSpacer {
     ignorepointer 1
     color 0.2549 0.2941 0.3451 1
     position 0 0
     size 1 1
     halign center_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     style rover_sim_colorable
    }
   }
   {
    ScriptParamsClass {
     Two_Way_Binding 1
     Relay_Command "GroupCollapseExecute"
    }
   }
  }
  WrapSpacerWidgetClass EditorDialogOptionContent {
   visible 1
   clipchildren 0
   ignorepointer 0
   color 0.1373 0.1569 0.1843 1
   position 0 1
   size 1 0
   halign center_ref
   hexactpos 1
   vexactpos 0
   hexactsize 0
   vexactsize 1
   scriptclass "ViewBinding"
   style Colorable
   Padding 8
   Margin 0
   "Size To Content V" 1
   {
    ScriptParamsClass {
     Binding_Name "Value"
    }
   }
  }
 }
}