WrapSpacerWidgetClass EditorOptionsWrapSpacer {
 size 1 30
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 Padding 0
 Margin 0
 {
  FrameWidgetClass EditorOptionLabelFrame {
   ignorepointer 1
   size 0.33 1
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass EditorOptionSliderLabel {
     ignorepointer 1
     position 0 0
     size 1 1
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     scriptclass "ViewBinding"
     text "Words and stuff"
     font "gui/fonts/MetronBook16"
     "text offset" -10 0
     "size to text h" 0
     "size to text v" 0
     "text halign" right
     "text valign" center
     color 0.6588 0.7059 0.7686 1
     {
      ScriptParamsClass {
       Binding_Name "Caption"
      }
     }
    }
   }
  }
  PanelWidgetClass EditorOptionSliderDownPanel {
   clipchildren 1
   ignorepointer 1
   color 0.1647 0.1843 0.2157 1
   position 0 0
   size 0.07 1
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
   {
    ButtonWidgetClass EditorOptionSliderDownButton {
     color 1 1 1 1
     position 0 0
     size 1 1
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     scriptclass "ViewBinding"
     style Editor
     {
      ImageWidgetClass EditorOptionSliderDownIcon {
       visible 1
       clipchildren 1
       inheritalpha 0
       ignorepointer 1
       color 0.6588 0.7059 0.7686 1
       position 0 0
       size 10 10
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_collapse"
       mode blend
       "src alpha" 1
       "clamp mode" clamp
       "stretch mode" stretch_h
       filter 1
       rotation 0 0 90
      }
     }
     {
      ScriptParamsClass {
       Relay_Command "OnButtonDown"
      }
     }
    }
   }
  }
  PanelWidgetClass EditorOptionSliderUpPanel {
   clipchildren 1
   ignorepointer 1
   color 0.1647 0.1843 0.2157 1
   position 0 0
   size 0.07 1
   halign right_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 4
   style rover_sim_colorable
   {
    ButtonWidgetClass EditorOptionSliderUpButton {
     color 1 1 1 1
     position 0 0
     size 1 1
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     scriptclass "ViewBinding"
     style Editor
     {
      ImageWidgetClass EditorOptionSliderUpIcon {
       visible 1
       clipchildren 1
       inheritalpha 0
       ignorepointer 1
       color 0.6588 0.7059 0.7686 1
       position 0 0
       size 10 10
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_collapse"
       mode blend
       "src alpha" 1
       "clamp mode" clamp
       "stretch mode" stretch_h
       "flip u" 0
       "flip v" 0
       filter 1
       rotation 0 0 270
      }
     }
     {
      ScriptParamsClass {
       Relay_Command "OnButtonUp"
      }
     }
    }
   }
  }
  SliderWidgetClass EditorOptionSliderSlider {
   visible 1
   clipchildren 1
   inheritalpha 0
   color 0.2471 0.5216 0.7922 1
   position 0 0
   size 0.49 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 2
   scriptclass "ViewBinding"
   style Slider_1px_alpha_50
   maximum 1
   step 0.001
   current 0.5
   vertical 0
   "fill in" 1
   "listen to input" 1
   {
    TextWidgetClass EditorOptionSliderReadout {
     clipchildren 1
     inheritalpha 0
     ignorepointer 1
     color 0.8667 0.8902 0.9255 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     scaled 0
     scriptclass "ViewBinding"
     text "10000"
     font "gui/fonts/MetronBook16"
     "exact text" 0
     "size to text h" 1
     "text halign" center
     "text valign" center
     {
      EditBoxWidgetClass EditorOptionSliderInput {
       visible 0
       color 0.8667 0.8902 0.9255 1
       position 0 0
       size 68 1
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 0
       scriptclass "ViewBinding"
       style Default
       text "10000"
       "limit visible" 0
       "exact text" 0
       font "gui/fonts/MetronBook16"
       {
        ScriptParamsClass {
         Binding_Name "CalculatedValue"
         Two_Way_Binding 1
        }
       }
      }
     }
     {
      ScriptParamsClass {
       Binding_Name "CalculatedValue"
       Two_Way_Binding 0
      }
     }
    }
    PanelWidgetClass SliderOutline_override {
     inheritalpha 0
     ignorepointer 1
     color 0.2549 0.2941 0.3451 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     style Outline_1px
    }
   }
   {
    ScriptParamsClass {
     Binding_Name "Value"
     Two_Way_Binding 1
    }
   }
  }
 }
}