   vexactsize 1
   scriptclass "ViewBinding"
   text "Caption"
   font "gui/fonts/MetronBook16"
   "text offset" 10 0
   "exact text" 0
   "size to text h" 0
   "size to text v" 0
   "text valign" center
   color 0.6588 0.7059 0.7686 1
   {
    ScriptParamsClass {
     Binding_Name "Label"
    }
   }
  }
  PanelWidgetClass ComtentBoxColor {
   ignorepointer 1
