PanelWidgetClass ButtonPanel {
 clipchildren 1
 ignorepointer 1
 size 128 30
 halign center_ref
 valign bottom_ref
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 scaled 1
 priority 1
 draggable 0
 scriptclass ""
 style blank
 {
  PanelWidgetClass ButtonOutline {
   visible 1
   clipchildren 1
   ignorepointer 1
   color 0.3333 0.3882 0.4510 1
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Outline_1px
   {
    ButtonWidgetClass Button {
     clipchildren 1
     color 0.2471 0.5216 0.7922 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     scaled 1
     scriptclass "ViewBinding"
     style Editor
     text "Find & Replace"
     text_proportion 0.86
     font "gui/fonts/MetronBook16"
     {
      ScriptParamsClass {
       Binding_Name "Value"
       Selected_Item "Caption"
       Two_Way_Binding 1
       Relay_Command "ButtonExecute"
      }
     }
    }
   }
  }
 }
}